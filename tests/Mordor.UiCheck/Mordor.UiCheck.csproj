<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Window behaviour that only shows with the real controls laid out: the Automap child resized,
    paged and clicked, in Avalonia's headless platform. Nothing is put on screen, nothing is
    played and nothing is written - run by tools/check.sh, MORDOR_CHECK_NO_UI or not.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- crops of CI's own pictures, for the checks of the picture comparison's noise threshold (PictureTools.SelfTest) -->
  <ItemGroup>
    <None Include="test-data\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.2.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.2.0" />
    <!-- Avalonia 12 has its text shaper apart from Skia: UseSkia names no shaper, so UseHarfBuzz does (the app's UsePlatformDetect brings it) -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mordor.Core\Mordor.Core.csproj" />
    <ProjectReference Include="..\..\src\Mordor.App\Mordor.App.csproj" />
    <!-- the DPS Meter mod's window, driven headless -->
    <ProjectReference Include="..\..\src\Mods\Mordor.Mod.DpsMeter\Mordor.Mod.DpsMeter.csproj" />
  </ItemGroup>

</Project>
