<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `dotnet test` for the existing suites: each test runs one of them (Mordor.Tests selfcheck, mods,
    citations; Mordor.UiCheck) as its own process against the game folder in MORDOR_GAMEDIR, and
    fails on a non-zero exit or any FAIL line. Without MORDOR_GAMEDIR every test is skipped, saying
    why. tools/check.sh stays the full gate (docs/TOOLS.md).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- built first, in the same configuration, and run from their own output folders (where the
       mods suite finds the bundled mods); nothing of theirs is referenced or copied here -->
  <ItemGroup>
    <ProjectReference Include="..\Mordor.Tests\Mordor.Tests.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Mordor.UiCheck\Mordor.UiCheck.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Mordor.Tests.Dir" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Mordor.Tests\bin\$(Configuration)\net8.0'))" />
    <AssemblyMetadata Include="Mordor.UiCheck.Dir" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Mordor.UiCheck\bin\$(Configuration)\net8.0'))" />
  </ItemGroup>

</Project>
