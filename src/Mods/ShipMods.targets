<Project>
  <!--
    The mods that come with the port, built with whatever imports this (Mordor.App, and
    Mordor.Tests for its mods suite) and copied into its output's mods folder, one folder per mod:
    <OutDir>/mods/QoL/{Mordor.Mod.QoL.dll, mod.json}, <OutDir>/mods/Kaizen/{Mordor.Mod.Kaizen.dll,
    mod.json}, <OutDir>/mods/DpsMeter/{Mordor.Mod.DpsMeter.dll, mod.json},
    <OutDir>/mods/Cartographer/{Mordor.Mod.Cartographer.dll, mod.json},
    <OutDir>/mods/AutoCombat/{Mordor.Mod.AutoCombat.dll, mod.json},
    <OutDir>/mods/ICloudSaves/{Mordor.Mod.ICloudSaves.dll, mod.json} (macOS only at run time; it
    loads and does nothing elsewhere). The loader looks there
    (docs/MODDING.md).
    Only the mod's own files are copied: the game's assemblies are the ones it runs against.
    A publish (dotnet publish, the release build: docs/RELEASING.md) puts the same files in the
    publish folder's mods folder, as the build does in its output.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.QoL\Mordor.Mod.QoL.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.Kaizen\Mordor.Mod.Kaizen.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.DpsMeter\Mordor.Mod.DpsMeter.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.Cartographer\Mordor.Mod.Cartographer.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.AutoCombat\Mordor.Mod.AutoCombat.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Mordor.Mod.ICloudSaves\Mordor.Mod.ICloudSaves.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- each bundled mod's files, with the folder under mods\ they go to. The mods are always built
       for any runtime (a RuntimeIdentifier given to a publish is not passed on to them), so their
       output is bin\<config>\net8.0 -->
  <Target Name="BundledModFiles">
    <PropertyGroup>
      <_QoLOut>$(MSBuildThisFileDirectory)Mordor.Mod.QoL\bin\$(Configuration)\net8.0\</_QoLOut>
      <_KaizenOut>$(MSBuildThisFileDirectory)Mordor.Mod.Kaizen\bin\$(Configuration)\net8.0\</_KaizenOut>
      <_DpsOut>$(MSBuildThisFileDirectory)Mordor.Mod.DpsMeter\bin\$(Configuration)\net8.0\</_DpsOut>
      <_CartoOut>$(MSBuildThisFileDirectory)Mordor.Mod.Cartographer\bin\$(Configuration)\net8.0\</_CartoOut>
      <_AutoOut>$(MSBuildThisFileDirectory)Mordor.Mod.AutoCombat\bin\$(Configuration)\net8.0\</_AutoOut>
      <_ICloudOut>$(MSBuildThisFileDirectory)Mordor.Mod.ICloudSaves\bin\$(Configuration)\net8.0\</_ICloudOut>
    </PropertyGroup>
    <ItemGroup>
      <_BundledModFile Include="$(_QoLOut)Mordor.Mod.QoL.dll;$(_QoLOut)mod.json" ModFolder="QoL" />
      <_BundledModFile Include="$(_KaizenOut)Mordor.Mod.Kaizen.dll;$(_KaizenOut)mod.json" ModFolder="Kaizen" />
      <_BundledModFile Include="$(_DpsOut)Mordor.Mod.DpsMeter.dll;$(_DpsOut)mod.json" ModFolder="DpsMeter" />
      <_BundledModFile Include="$(_CartoOut)Mordor.Mod.Cartographer.dll;$(_CartoOut)mod.json" ModFolder="Cartographer" />
      <_BundledModFile Include="$(_AutoOut)Mordor.Mod.AutoCombat.dll;$(_AutoOut)mod.json" ModFolder="AutoCombat" />
      <_BundledModFile Include="$(_ICloudOut)Mordor.Mod.ICloudSaves.dll;$(_ICloudOut)mod.json" ModFolder="ICloudSaves" />
      <!-- the symbols, where the build wrote a separate file (not with DebugType embedded or none) -->
      <_BundledModFile Include="$(_QoLOut)Mordor.Mod.QoL.pdb" ModFolder="QoL" Condition="Exists('$(_QoLOut)Mordor.Mod.QoL.pdb')" />
      <_BundledModFile Include="$(_KaizenOut)Mordor.Mod.Kaizen.pdb" ModFolder="Kaizen" Condition="Exists('$(_KaizenOut)Mordor.Mod.Kaizen.pdb')" />
      <_BundledModFile Include="$(_DpsOut)Mordor.Mod.DpsMeter.pdb" ModFolder="DpsMeter" Condition="Exists('$(_DpsOut)Mordor.Mod.DpsMeter.pdb')" />
      <_BundledModFile Include="$(_CartoOut)Mordor.Mod.Cartographer.pdb" ModFolder="Cartographer" Condition="Exists('$(_CartoOut)Mordor.Mod.Cartographer.pdb')" />
      <_BundledModFile Include="$(_AutoOut)Mordor.Mod.AutoCombat.pdb" ModFolder="AutoCombat" Condition="Exists('$(_AutoOut)Mordor.Mod.AutoCombat.pdb')" />
      <_BundledModFile Include="$(_ICloudOut)Mordor.Mod.ICloudSaves.pdb" ModFolder="ICloudSaves" Condition="Exists('$(_ICloudOut)Mordor.Mod.ICloudSaves.pdb')" />
    </ItemGroup>
  </Target>

  <Target Name="ShipBundledMods" AfterTargets="Build" DependsOnTargets="BundledModFiles">
    <Copy SourceFiles="@(_BundledModFile)" DestinationFiles="@(_BundledModFile->'$(OutDir)mods\%(ModFolder)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- the same files in a publish, at the same places under the publish folder -->
  <Target Name="PublishBundledMods" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BundledModFiles">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledModFile)"
                             RelativePath="mods\%(_BundledModFile.ModFolder)\%(_BundledModFile.Filename)%(_BundledModFile.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
