<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Auto-combat mod (docs/MODDING.md). Built with the game: src/Mods/ShipMods.targets copies its .dll
       and mod.json into <program>/mods/AutoCombat, where the loader finds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the game's own copies are used at run time, so none is copied beside the mod -->
    <ProjectReference Include="..\..\Mordor.Modding\Mordor.Modding.csproj" Private="false" />
    <ProjectReference Include="..\..\Mordor.Core\Mordor.Core.csproj" Private="false" />
    <!-- the Auto-combat window (the rules); the game supplies Avalonia at run time, so none is copied -->
    <PackageReference Include="Avalonia" Version="11.2.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
