<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Mordor.App"
        x:Class="Mordor.App.AutomapWindow"
        Title="Automap" Width="640" Height="700"
        FontFamily="Cascadia Mono, Consolas, monospace"
        WindowStartupLocation="CenterOwner"
        Background="#0a0a10">
    <!--
        One row above the map, which is what Form_Resize builds: hsbLevel, lblLevel immediately to
        its right, and lblInfo right-aligned to the far edge of the picture (FRMAUTOM.BAS:105-120).
        Nothing else. There is no legend on the form and none in the help's AutoMap page; the one
        this port used to print under the map explaining what each colour meant was invented, and
        it took up a third of the window saying what the map already shows.
    -->
    <!--
        The form itself, with its controls laid on it as the original places them: the level row
        at the top, and picPicture, which moves. At full height it sits below the level row
        (FRMAUTOM.BAS:490-493), and on a form shorter than that it goes to the top and fills the
        form, over the slider and both labels (478-489). Across, the same: at full width it keeps
        its margin, narrower it runs from the left edge to the right (461-476). See
        AutomapWindow.Place. Clipped, so a row wider than a narrow form does not paint past it.
    -->
    <!-- the form's own MS Sans Serif 8.25 through the Options fonts (UiFonts), for everything on it -->
    <Panel x:Name="FormArea" ClipToBounds="True" app:UiFonts.Font="frmAutoMap">
        <Grid x:Name="LevelRow" VerticalAlignment="Top" ColumnDefinitions="Auto,4,Auto,4,Auto,10,Auto,10,*" Margin="10,10,10,8">
            <!-- the two ends of hsbLevel. They were labelled "deeper" and "up" here; a scrollbar arrow
                 says neither, and the words cost the row the width lblInfo needs -->
            <Button Grid.Column="0" x:Name="DeeperBtn" Content="▼" Padding="7,3" Click="OnDeeper"/>
            <!-- hsbLevel is a scrollbar of its own width, not one that eats the row: lblInfo is the
                 thing anchored to the far edge (FRMAUTOM.BAS:119) -->
            <Slider Grid.Column="2" x:Name="LevelSlider" Minimum="1" Maximum="1" TickFrequency="1"
                    Width="74" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <Button Grid.Column="4" x:Name="ShallowerBtn" Content="▲" Padding="7,3" Click="OnShallower"/>
            <!-- lblLevel and lblInfo in their own fonts, the form's MS Sans Serif 8.25 (MORDOR.EXE,
                 frmAutoMap), through the Options fonts; they had been the frame's Cascadia Mono -->
            <TextBlock Grid.Column="6" x:Name="LevelLabel" Foreground="#8fb0ff" FontWeight="Bold"
                       app:UiFonts.Font="frmAutoMap.lblLevel" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="8" x:Name="InfoLabel" Foreground="#8fb0ff" VerticalAlignment="Center"
                       app:UiFonts.Font="frmAutoMap.lblInfo" HorizontalAlignment="Right" TextWrapping="Wrap"/>
        </Grid>

        <!--
            picPicture (MapClip), and in it picMaze with the two rows of numbers around it.
            The original draws the whole level at a fixed fifteen pixels a square and scrolls the
            picture under the window when the window is too small to hold it (modAdjustMap,
            FRMAUTOM.BAS:457-500); the numbers down the left and along the bottom are only printed
            once the window is big enough for the whole map (sub2E18, FRMAUTOM.BAS:503-522).

            The map is never shrunk: shrinking a picture of one-pixel lines drops whole columns and
            rows of it. Below full size it is drawn at its own size and only moved (see
            AutomapWindow.Place). On a full-size form the port - not the original, which only ever
            BitBlts it 1:1 - enlarges it to fill the picture and centres it (AutomapLayout.Zoom, a
            GUI deviation in docs/FIDELITY.md).

            MapBox holds the numbers alone, scaled with the map. picMaze, MapImage, is beside it
            rather than in it: its bitmap is drawn at the device's own pixels for the size shown
            (AutomapLayout.DeviceEdges) and put down one bitmap pixel to one device pixel, so
            nothing stretches it but a resize still being dragged. The picture has a background
            of its own - the child's - because on a short form it lies over the level row.
        -->
        <Canvas x:Name="MapClip" ClipToBounds="True" Background="#12121a" Margin="10,40,10,10">
            <Viewbox x:Name="MapBox" Stretch="Fill">
                <Canvas x:Name="MapArea" Background="Transparent"/>
            </Viewbox>
            <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
            <!-- the mods' marks (API version 13), laid over picMaze: hidden, and drawing nothing, with no
                 mod marking anything (AutomapOverlay) -->
            <app:AutomapOverlay x:Name="MapMarks" IsVisible="False"/>
        </Canvas>
    </Panel>
</Window>
