<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the program is OpenDejenol: OpenDejenol.exe, OpenDejenol.dll. The project and its
         namespace keep the Mordor.App name the rest of the source uses. -->
    <AssemblyName>OpenDejenol</AssemblyName>
    <RootNamespace>Mordor.App</RootNamespace>
    <Product>OpenDejenol</Product>
    <AssemblyTitle>OpenDejenol</AssemblyTitle>
    <Description>OpenDejenol - a faithful engine for Mordor: The Depths of Dejenol, played from the player's own copy</Description>
    <!-- The program's version, set here and nowhere else (docs/RELEASING.md): SemVer, with a
         suffix for a test release (0.2.0-beta.1). A release is tagged v + this exactly, and the
         release workflow refuses a tag that differs. It names the installer's package, is what
         the update check compares, and is shown on the Mods page. Only the program carries it:
         Mordor.Core and Mordor.Modding, which mods are built against, keep their own. -->
    <Version>0.1.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <!-- the DataGrid has had its own release line since 11.3: 12.1.2 is its newest 12.x -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <!-- installs and updates (docs/RELEASING.md): the install/update hooks at the top of Main,
         and the update check against the GitHub releases (Updates.cs) -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mordor.Core\Mordor.Core.csproj" />
    <ProjectReference Include="..\Mordor.Modding\Mordor.Modding.csproj" />
  </ItemGroup>

  <!-- the licence goes with every copy given out: into the publish folder, and from there into the
       installer's package and the portable zip (docs/RELEASING.md) -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" Visible="false" />
  </ItemGroup>

  <!-- the SoundFont the port's MIDI synthesizer plays with (MidiPlayer), with its own licence and
       credit beside it: a separate data file, read at run time (soundfont/README.txt) -->
  <ItemGroup>
    <None Include="soundfont\TimGM6mb.sf2;soundfont\GPL-2.0.txt;soundfont\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the mods that come with the port, into bin/<config>/net10.0/mods and a publish's mods (docs/MODDING.md) -->
  <Import Project="..\Mods\ShipMods.targets" />

  <!-- No pictures or help of the game's own are built in: they are read out of the player's copy at
       start (Art.cs, src/Mordor.Core/Extraction, docs/GAME_FILES.md). -->

  <!-- The program's own icon, which is the port's and not the game's (Assets/Icon, docs/TOOLS.md
       "The program's icon"): the exe's, and every window's through the Window style in App.axaml. -->
  <PropertyGroup>
    <ApplicationIcon>Assets\Icon\opendejenol.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Icon\opendejenol.ico" />
  </ItemGroup>

  <!-- the Liberation fonts, the stand-ins for Windows' own faces away from Windows (PortFonts),
       built in, with their licence (SIL OFL 1.1) beside the program -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\Liberation\*.ttf" />
    <None Include="Assets\Fonts\Liberation\LICENSE.txt" Link="fonts\Liberation-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
