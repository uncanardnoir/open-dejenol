<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mordor.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <!-- one accent, the port's own, rather than Windows': with Windows set to pick its accent from
             the wallpaper, a ticked box and a selected row took whatever colour the desktop had at the
             time - gold on the Mods page from the title screen, blue-grey from the Control Panel -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#2f5597"/>
                <ColorPaletteResources x:Key="Light" Accent="#2f5597"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- the program's icon on every window - the game's own, the dialogs, the mods' - in place of
             Avalonia's logo. :is takes in each window class as well as a plain Window. -->
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="avares://OpenDejenol/Assets/Icon/opendejenol.ico"/>
        </Style>
    </Application.Styles>
</Application>
