<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod API (docs/MODDING.md): what a mod references, and the loader the game runs. No
       Avalonia here, so the loader and every hook can be exercised headless by Mordor.Tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mordor.Core\Mordor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

</Project>
